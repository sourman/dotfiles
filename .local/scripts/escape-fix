#!/bin/bash
# Unstick Escape when X11/desktop daemons swallow it. Safe to run any time.
set -euo pipefail

echo "escape-fix: clearing stuck modifiers..."
xmodmap -e 'mod1 = Alt_L Alt_R Meta_L' 2>/dev/null || true
xset -r 2>/dev/null || true
xset r rate 250 30 2>/dev/null || true

echo "escape-fix: restarting input stack..."
if pgrep -x Cap >/dev/null; then
  echo "escape-fix: killing Cap (global input hooks eat Escape)..."
  killall Cap 2>/dev/null || true
  sleep 0.3
fi
killall xcape 2>/dev/null || true
ibus restart 2>/dev/null || true
sleep 0.5

if command -v xfwm4 >/dev/null; then
  echo "escape-fix: restarting xfwm4 (clears stuck cancel_key / move grabs)..."
  DISPLAY="${DISPLAY:-:0}" xfwm4 --replace >/dev/null 2>&1 &
  sleep 0.8
fi

if [[ -x "$HOME/.local/scripts/xcape-rofi-super-tap" ]]; then
  echo "escape-fix: starting xcape Super-tap..."
  "$HOME/.local/scripts/xcape-rofi-super-tap" &
fi

# Neovim/Kitty can leave CSI u keyboard protocol stuck in existing terminals.
printf '\033[<u\033[>0u' 2>/dev/null || true

echo "escape-fix: done. Try Escape in vim insert mode."
